# Dependencies
node_modules/

# Environment (keep the .env.example files tracked)
.env
.env.*
!.env.example

# Build output
dist/
build/
coverage/

# Prisma client, generated by `prisma generate`
server/src/generated/

# SQLite databases
*.db
*.db-journal
*.sqlite

# Logs
*.log
npm-debug.log*

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Local Claude Code settings
.claude/settings.local.json

# Postman's local-files sync (YAML). Only the exported collection is tracked.
docs/postman/*
!docs/postman/*.postman_collection.json

# Playwright
client/test-results/
client/playwright-report/
