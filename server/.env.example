# SQLite file, relative to server/ (used by both the Prisma CLI and the app)
DATABASE_URL="file:./dev.db"
# Long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me"
PORT=3000
# Origin of the client allowed by CORS
CLIENT_ORIGIN="http://localhost:5173"
# Geocoder for the studio address: "nominatim" (OpenStreetMap, the default)
# or "fake" (no network: the centre of the city, for tests and offline work)
GEOCODER="nominatim"
# Sent to Nominatim, as its usage policy asks: the app name and a contact URL
NOMINATIM_USER_AGENT="nAIlbook (https://github.com/Anina1999/nAIlbook)"
